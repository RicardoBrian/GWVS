rules_version = '2';

// 접속: Google 로그인만 받는다(익명 로그인 차단).
// 권한: 관리자(admins/{이메일}) > 승인된 담임(자기 반만) > 승인된 비담임(교육과정 외 도우미만).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    function teacherPath() {
      return /databases/$(database)/documents/teachers/$(request.auth.uid);
    }
    function isApproved() {
      return signedIn() && exists(teacherPath()) && get(teacherPath()).data.status == 'approved';
    }
    function canRead() {
      return isAdmin() || isApproved();
    }
    function isHomeroom(g, k) {
      return isApproved()
        && get(teacherPath()).data.homeroom == true
        && get(teacherPath()).data.grade == g
        && get(teacherPath()).data.klass == k;
    }
    function canClass(g, k) {
      return isAdmin() || isHomeroom(g, k);
    }

    // 관리자 목록: 문서 ID = 관리자 이메일. 본인 문서만 조회, 등록/삭제는 Firebase 콘솔에서.
    match /admins/{adminEmail} {
      allow get: if signedIn() && request.auth.token.email == adminEmail;
      allow list, write: if false;
    }

    // 교사 가입 신청: 본인은 "승인 대기" 상태로만 쓰고 고칠 수 있다. 승인·거절은 관리자만.
    // 도장(stamp)은 본인이 언제든 바꿀 수 있다(다른 칸은 그대로일 때만).
    match /teachers/{uid} {
      function validApplication() {
        let d = request.resource.data;
        return d.status == 'pending'
          && d.email == request.auth.token.email
          && d.name is string && d.name.size() > 0 && d.name.size() <= 30
          && d.homeroom is bool
          && (d.homeroom == false || (d.grade is int && d.klass is int))
          && d.keys().hasOnly(['name', 'email', 'homeroom', 'grade', 'klass', 'status', 'createdAt', 'updatedAt', 'stamp', 'stampUpdatedAt']);
      }
      function stampOnly() {
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys().hasOnly(['stamp', 'stampUpdatedAt'])
          && (!('stamp' in d) || (d.stamp is string && d.stamp.size() < 200000 && d.stamp.matches('^data:image/png;base64,.*')));
      }
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid && validApplication();
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && (validApplication() || stampOnly()));
      allow delete: if isAdmin();
    }

    match /artifacts/{appId}/public/data {

      // 교육과정 외: 도우미 명단. 승인된 교사는 시간·내용 수정, 추가·삭제는 관리자.
      match /students/{id} {
        allow read, update: if canRead();
        allow create, delete: if isAdmin();
      }
      match /logs/{id} {
        allow read, create: if canRead();
        allow update, delete: if isAdmin();
      }
      match /settings/{id} {
        allow read: if canRead();
        allow write: if isAdmin();
      }

      // 교육과정 내: 활동은 관리자만 만든다.
      match /events/{id} {
        allow read: if canRead();
        allow write: if isAdmin();
      }

      // 전교생 명단: 문서 ID = 학년-반-번호. 담임은 자기 반 학생만 쓰고 지운다.
      match /roster/{id} {
        allow read: if canRead();
        allow create, update: if canClass(request.resource.data.grade, request.resource.data.klass)
          && request.resource.data.number is int
          && id == string(request.resource.data.grade) + '-' + string(request.resource.data.klass) + '-' + string(request.resource.data.number)
          && (resource == null || canClass(resource.data.grade, resource.data.klass));
        allow delete: if canClass(resource.data.grade, resource.data.klass);
      }

      // 활동별·학급별 불참 학생: 문서 ID = 활동ID_학년-반. 담임은 자기 반, 마감 전에만.
      match /attendance/{id} {
        function eventOpen(eid) {
          let path = /databases/$(database)/documents/artifacts/$(appId)/public/data/events/$(eid);
          return exists(path) && get(path).data.get('finalized', false) != true;
        }
        allow read: if canRead();
        allow create, update: if canClass(request.resource.data.grade, request.resource.data.klass)
          && id == request.resource.data.eventId + '_' + string(request.resource.data.grade) + '-' + string(request.resource.data.klass)
          && (resource == null || canClass(resource.data.grade, resource.data.klass))
          && eventOpen(request.resource.data.eventId);
        allow delete: if isAdmin();
      }
    }

    // 그 외 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
